{
  "contract_version": "1.0.0",
  "plugin": "cognition",
  "resources": [
    {
      "name": "cognition_record",
      "scope": "private_store",
      "schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "archived": {
            "type": "boolean"
          },
          "fields": {
            "type": "object",
            "properties": {
              "pattern_id": {
                "type": "string",
                "description": "pattern id",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time",
                "description": "reviewed at"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "evidence refs"
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "kind",
          "version",
          "created_at",
          "updated_at",
          "archived",
          "fields"
        ],
        "additionalProperties": false
      },
      "identity": [
        "id",
        "kind",
        "version"
      ],
      "store_id_required": true
    }
  ]
}
